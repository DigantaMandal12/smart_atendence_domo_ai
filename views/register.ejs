<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <meta
        name="theme-color"
        content="#2563eb"
    >

    <title>Register | Smart Academic AI</title>

    <link
        rel="stylesheet"
        href="/css/auth.css"
    >

</head>

<body>

<div class="auth-page">

    <div class="auth-card register-card">

        <div class="brand">

            <div class="brand-icon">
                🎓
            </div>

            <div>

                <h1>
                    Smart Academic AI
                </h1>

                <p>
                    AI Study Assistant
                </p>

            </div>

        </div>


        <div class="auth-heading">

            <h2>
                Create your account
            </h2>

            <p>
                Build your personalized academic profile.
            </p>

        </div>


        <div
            id="authError"
            class="alert error hidden"
        ></div>


        <div
            id="authSuccess"
            class="alert success hidden"
        ></div>


        <form
            id="registerForm"
            autocomplete="off"
        >

            <div class="form-group">

                <label for="name">
                    Full name
                </label>

                <div class="input-box">

                    <span>👤</span>

                    <input
                        id="name"
                        name="name"
                        type="text"
                        placeholder="Enter your full name"
                        autocomplete="name"
                        minlength="2"
                        maxlength="80"
                        required
                    >

                </div>

            </div>


            <div class="form-group">

                <label for="registerEmail">
                    Email address
                </label>

                <div class="input-box">

                    <span>✉️</span>

                    <input
                        id="registerEmail"
                        name="email"
                        type="email"
                        placeholder="you@example.com"
                        autocomplete="email"
                        required
                    >

                </div>

            </div>


            <div class="two-columns">

                <div class="form-group">

                    <label for="semester">
                        Semester
                    </label>

                    <div class="input-box">

                        <span>🎓</span>

                        <select id="semester">

                            <option value="">
                                Select
                            </option>

                            <option value="1st">
                                1st Semester
                            </option>

                            <option value="2nd">
                                2nd Semester
                            </option>

                            <option value="3rd">
                                3rd Semester
                            </option>

                            <option value="4th">
                                4th Semester
                            </option>

                            <option value="5th">
                                5th Semester
                            </option>

                            <option value="6th">
                                6th Semester
                            </option>

                            <option value="7th">
                                7th Semester
                            </option>

                            <option value="8th">
                                8th Semester
                            </option>

                        </select>

                    </div>

                </div>


                <div class="form-group">

                    <label for="branch">
                        Branch
                    </label>

                    <div class="input-box">

                        <span>💻</span>

                        <select id="branch">

                            <option value="">
                                Select
                            </option>

                            <option value="CSE">
                                CSE
                            </option>

                            <option value="IT">
                                IT
                            </option>

                            <option value="ECE">
                                ECE
                            </option>

                            <option value="EE">
                                EE
                            </option>

                            <option value="ME">
                                ME
                            </option>

                            <option value="CE">
                                CE
                            </option>

                        </select>

                    </div>

                </div>

            </div>


            <div class="form-group">

                <label for="registerPassword">
                    Password
                </label>

                <div class="input-box">

                    <span>🔒</span>

                    <input
                        id="registerPassword"
                        type="password"
                        placeholder="Create a strong password"
                        autocomplete="new-password"
                        minlength="6"
                        required
                    >

                    <button
                        type="button"
                        class="eye-button"
                        data-target="registerPassword"
                    >
                        👁
                    </button>

                </div>


                <div class="password-strength">

                    <div class="strength-bar">

                        <span
                            id="strengthFill"
                        ></span>

                    </div>

                    <small id="strengthText">
                        Use 8+ characters with uppercase,
                        lowercase, number and symbol.
                    </small>

                </div>

            </div>


            <div class="form-group">

                <label for="confirmPassword">
                    Confirm password
                </label>

                <div class="input-box">

                    <span>🔒</span>

                    <input
                        id="confirmPassword"
                        type="password"
                        placeholder="Re-enter your password"
                        autocomplete="new-password"
                        required
                    >

                    <button
                        type="button"
                        class="eye-button"
                        data-target="confirmPassword"
                    >
                        👁
                    </button>

                </div>


                <small
                    id="passwordMatch"
                    class="field-message"
                ></small>

            </div>


            <label class="terms">

                <input
                    id="terms"
                    type="checkbox"
                    required
                >

                <span>

                    I agree to the
                    <a href="#">
                        Terms
                    </a>
                    and
                    <a href="#">
                        Privacy Policy
                    </a>

                </span>

            </label>


            <button
                id="registerButton"
                type="submit"
                class="primary-button"
            >

                <span class="button-text">
                    Create account
                </span>

                <span class="loader hidden"></span>

            </button>

        </form>


        <div class="auth-footer">

            <span>
                Already have an account?
            </span>

            <a href="/login">
                Login
            </a>

        </div>

    </div>

</div>


<script
    type="module"
    src="/js/auth.js"
></script>

</body>

</html>