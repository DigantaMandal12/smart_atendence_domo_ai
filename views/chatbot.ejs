<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <meta
        name="theme-color"
        content="#2563eb"
    >

    <title>Smart Academic AI</title>

    <link
        rel="stylesheet"
        href="/css/chatbot.css"
    >

    <!-- =========================================
         MARKDOWN
    ========================================== -->

    <script
        src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"
    ></script>


    <!-- =========================================
         XSS PROTECTION
    ========================================== -->

    <script
        src="https://cdn.jsdelivr.net/npm/dompurify@3.2.6/dist/purify.min.js"
    ></script>

</head>


<body>


    <main class="page-wrapper">


        <section class="chat-container">


            <!-- =========================================
                 HEADER
            ========================================== -->

            <header class="chat-header">


                <!-- BRAND -->

                <div class="brand-section">


                    <div class="ai-avatar large">
                        🎓
                    </div>


                    <div class="brand-text">

                        <h1>
                            Smart Academic AI
                        </h1>

                        <p>
                            AI Study Assistant
                        </p>

                    </div>

                </div>


                <!-- HEADER ACTIONS -->

                <div class="header-actions">


                    <!-- PROFILE -->

                    <a
                        href="/profile"
                        class="profile-button"
                        title="My Profile"
                    >

                        <span class="profile-icon">
                            👤
                        </span>


                        <span class="profile-name">

                            <%= user && user.name
                                ? user.name
                                : "Profile" %>

                        </span>

                    </a>


                    <!-- ONLINE -->

                    <div class="online-status">

                        <span
                            class="online-dot"
                        ></span>

                        <span>
                            Online
                        </span>

                    </div>


                    <!-- LOGOUT -->

                    <button
                        id="logoutButton"
                        class="logout-button"
                        type="button"
                        title="Logout"
                    >

                        <span>
                            🚪
                        </span>

                        <span class="logout-text">
                            Logout
                        </span>

                    </button>


                </div>

            </header>



            <!-- =========================================
                 CONVERSATION
            ========================================== -->

            <section
                id="chatBox"
                class="chat-box"
            >


                <!-- WELCOME MESSAGE -->

                <div
                    class="message-row bot-row"
                >


                    <div class="ai-avatar">
                        🎓
                    </div>


                    <div
                        class="message bot-message"
                    >


                        <div
                            class="message-title"
                        >
                            👋 Hello!
                            I'm your Smart Academic AI.
                        </div>


                        <p>
                            I can help you understand
                            subjects, solve questions
                            and prepare for exams.
                        </p>


                        <p
                            class="ask-title"
                        >
                            You can ask me about:
                        </p>


                        <ul
                            class="topic-list"
                        >

                            <li>
                                📚 Data Structures
                            </li>

                            <li>
                                💻 Computer Organization
                            </li>

                            <li>
                                🔌 Analog & Digital Electronics
                            </li>

                            <li>
                                📝 Exam preparation
                            </li>

                        </ul>

                    </div>

                </div>

            </section>



            <!-- =========================================
                 TYPING INDICATOR
            ========================================== -->

            <div
                id="typingIndicator"
                class="typing-indicator hidden"
            >


                <div
                    class="typing-avatar"
                >
                    🎓
                </div>


                <div
                    class="typing-bubble"
                >

                    <span></span>
                    <span></span>
                    <span></span>

                    <small>
                        AI is thinking...
                    </small>

                </div>

            </div>



            <!-- =========================================
                 INPUT / COMPOSER
            ========================================== -->

            <footer class="composer">


                <div class="input-wrapper">

                    <input
                        type="text"
                        id="messageInput"
                        placeholder="Ask your academic question..."
                        autocomplete="off"
                        maxlength="2000"
                    >

                </div>


                <button
                    id="sendButton"
                    class="send-button"
                    type="button"
                >

                    <span>
                        Send
                    </span>

                    <span
                        class="send-icon"
                    >
                        ➤
                    </span>

                </button>

            </footer>


        </section>

    </main>



    <!-- =========================================
         LOGOUT SCRIPT
    ========================================== -->

    <script>

        const logoutButton =
            document.getElementById(
                "logoutButton"
            );


        logoutButton?.addEventListener(
            "click",
            async () => {


                const confirmed =
                    window.confirm(
                        "Are you sure you want to logout?"
                    );


                if (!confirmed) {
                    return;
                }


                try {


                    logoutButton.disabled =
                        true;


                    logoutButton.innerHTML =
                        "⏳";


                    const response =
                        await fetch(
                            "/logout",
                            {
                                method: "POST",
                                credentials: "include"
                            }
                        );


                    if (!response.ok) {

                        throw new Error(
                            "Logout failed."
                        );

                    }


                    window.location.href =
                        "/login";


                } catch (error) {


                    console.error(
                        "Logout error:",
                        error
                    );


                    logoutButton.disabled =
                        false;


                    logoutButton.innerHTML =
                        "🚪 <span class='logout-text'>Logout</span>";


                    alert(
                        "Unable to logout. Please try again."
                    );

                }

            }
        );

    </script>



    <!-- =========================================
         CHATBOT JAVASCRIPT
    ========================================== -->

    <script
        src="/js/chatbot.js"
    ></script>


</body>

</html>