<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <meta
        name="theme-color"
        content="#2563eb"
    >

    <title>Smart Academic AI</title>

    <link
        rel="stylesheet"
        href="/css/chatbot.css"
    >

    <!-- Markdown -->
    <script
        src="https://cdn.jsdelivr.net/npm/marked/marked.min.js">
    </script>

    <!-- XSS Protection -->
    <script
        src="https://cdn.jsdelivr.net/npm/dompurify@3.2.6/dist/purify.min.js">
    </script>

</head>

<body>

    <main class="page-wrapper">

        <section class="chat-container">

            <!-- ==============================
                 HEADER
            =============================== -->

            <header class="chat-header">

                <div class="brand-section">

                    <div class="ai-avatar large">
                        🎓
                    </div>

                    <div class="brand-text">

                        <h1>
                            Smart Academic AI
                        </h1>

                        <p>
                            AI Study Assistant
                        </p>

                    </div>

                </div>


                <div class="online-status">

                    <span class="online-dot"></span>

                    <span>
                        Online
                    </span>

                </div>

            </header>


            <!-- ==============================
                 CONVERSATION
            =============================== -->

            <section
                id="chatBox"
                class="chat-box"
            >

                <!-- Welcome Message -->

                <div class="message-row bot-row">

                    <div class="ai-avatar">
                        🎓
                    </div>

                    <div class="message bot-message">

                        <div class="message-title">
                            👋 Hello! I'm your Smart Academic AI.
                        </div>

                        <p>
                            I can help you understand subjects,
                            solve questions and prepare for exams.
                        </p>

                        <p class="ask-title">
                            You can ask me about:
                        </p>

                        <ul class="topic-list">

                            <li>
                                📚 Data Structures
                            </li>

                            <li>
                                💻 Computer Organization
                            </li>

                            <li>
                                🔌 Analog & Digital Electronics
                            </li>

                            <li>
                                📝 Exam preparation
                            </li>

                        </ul>

                    </div>

                </div>

            </section>


            <!-- ==============================
                 TYPING INDICATOR
            =============================== -->

            <div
                id="typingIndicator"
                class="typing-indicator hidden"
            >

                <div class="typing-avatar">
                    🎓
                </div>

                <div class="typing-bubble">

                    <span></span>
                    <span></span>
                    <span></span>

                    <small>
                        AI is thinking...
                    </small>

                </div>

            </div>


            <!-- ==============================
                 INPUT
            =============================== -->

            <footer class="composer">

                <div class="input-wrapper">

                    <input
                        type="text"
                        id="messageInput"
                        placeholder="Ask your academic question..."
                        autocomplete="off"
                        maxlength="2000"
                    >

                </div>

                <button
                    id="sendButton"
                    class="send-button"
                    type="button"
                >

                    <span>
                        Send
                    </span>

                    <span class="send-icon">
                        ➤
                    </span>

                </button>

            </footer>

        </section>

    </main>


    <script src="/js/chatbot.js"></script>

</body>

</html>